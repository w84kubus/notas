# Notas nie czyta pliku .env. To są zmienne środowiskowe procesu Node.
# Lokalnie wystarczą domyślne wartości; na hostingu ustaw je w panelu usługi.
# (Render: render.yaml, Fly.io: fly.toml. Obie konfiguracje już je zawierają.)

# Port serwera. Hosting zwykle ustawia go sam (Render: 10000).
PORT=8787

# 1 = serwer stoi za proxy hostingu i bierze adres IP z jego nagłówków
# (fly-client-ip, cf-connecting-ip, X-Forwarded-For). Bez tego limit prób
# zgadywania kodów liczyłby wszystkich użytkowników jako jedno IP.
# Lokalnie zostaw puste.
TRUST_PROXY=

# Po ilu godzinach bez ruchu pokój znika (domyślnie 12).
ROOM_TTL_HOURS=12

# production = serwer oddaje zbudowany front z dist/ (npm start ustawia to sam).
# Bez tego (npm run dev) Vite jest wbudowany w serwer.
# NODE_ENV=production
